# Application
APP_ENV=development
APP_NAME=Supply-Chain Reconciliation Engine
LOG_LEVEL=INFO

# Uploads (relative to backend/ when running uvicorn from backend/)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Database (local uvicorn against Compose Postgres, or override for tests)
# Do not commit real credentials. Change passwords before any shared deployment.
POSTGRES_USER=reconcile
POSTGRES_PASSWORD=reconcile
POSTGRES_DB=reconcile
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://reconcile:reconcile@localhost:5432/reconcile

# Reconciliation policies (INR fixtures use 2 decimal places)
MONEY_DECIMAL_PLACES=2
PRICE_TOLERANCE=0.00
QUANTITY_TOLERANCE=0.000

# Optional Compose port mapping
BACKEND_PORT=8000

# Task B: LLM API keys will be added later — never commit secrets
